  m_Script: {fileID: 11500000, guid: 1b4f4e3033c0b1948b37362c71cc58a1, type: 3}
  m_Name: Exp1_Spectrophotometry
  m_EditorClassIdentifier: Assembly-CSharp::ExperimentData
  experimentName: Spectrophotometry
  experimentDescription: Spectrophotometry is an analytical technique that measures
    how much light a chemical substance absorbs when a beam of light passes through
    it.
  steps:
  - instructionText: "Pipette 10 \xB5L of BSA stock and 790 \xB5L of distilled water
      into S1."
    stepTitle: "Prepare S1 (10 \xB5g/mL)"
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: "Pipette 20 \xB5L of BSA stock and 780 \xB5L of distilled water
      into S2."
    stepTitle: "Prepare S2 (20 \xB5g/mL)"
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: "Pipette 30 \xB5L of BSA stock and 770 \xB5L of distilled water
      into S3"
    stepTitle: "Prepare S3 (30 \xB5g/mL)"
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: "Pipette 40 \xB5L of BSA stock and 760 \xB5L of distilled water
      into S4."
    stepTitle: "Prepare S4 (40 \xB5g/mL)"
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: "Pipette 50 \xB5L of BSA stock and 750 \xB5L of distilled water
      into S5."
    stepTitle: "Prepare S5 (50 \xB5g/mL)"
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: "Pipette 100 \xB5L of Unknown sample and 700 \xB5L of distilled
      water into the Unknown tube."
    stepTitle: Prepare Unknown
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: "Add 200 \xB5L of Bradford reagent to all 7 test tubes."
    stepTitle: Add Bradford Reagent
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: Vortex all test tubes, then wait 5 minutes for the color to
      develop.
    stepTitle: Mix and Incubate
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: Transfer solutions to cuvettes. Measure and record absorbance
      at 595 nm for all samples.
    stepTitle: Measure Absorbance
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
